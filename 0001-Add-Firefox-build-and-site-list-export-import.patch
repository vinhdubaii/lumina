+// ---------- export / import of the site list ----------
+// Only the list (domain + daily limit) moves between browsers. Usage history
+// and the live tracking state stay where they are.
+
+const exportBtn = document.getElementById("export-btn");
+const importBtn = document.getElementById("import-btn");
+const importFile = document.getElementById("import-file");
+const statusEl = document.getElementById("transfer-status");
+
+function showStatus(text, isError = false) {
+  statusEl.textContent = text;
+  statusEl.classList.toggle("is-error", isError);
+  statusEl.hidden = false;
+}
+
+function normalizeDomain(raw) {
+  if (typeof raw !== "string") return null;
+  const value = raw.trim().toLowerCase();
+  if (!value) return null;
+  try {
+    const host = new URL(value.includes("://") ? value : `https://${value}`).hostname;
+    return host.replace(/^www\./, "") || null;
+  } catch {
+    return null;
+  }
+}
+
+// Accepts the file Lumina exports ({ sites: {...} }) or a bare { domain: {...} } map.
+function parseImport(text) {
+  const data = JSON.parse(text);
+  const source = data && typeof data === "object" && data.sites ? data.sites : data;
+  if (!source || typeof source !== "object" || Array.isArray(source)) {
+    throw new Error("File không đúng định dạng Lumina.");
+  }
+  const valid = [];
+  let skipped = 0;
+  for (const [rawDomain, value] of Object.entries(source)) {
+    const domain = normalizeDomain(rawDomain);
+    const limit = Math.round(Number(value && value.limitMinutes));
+    if (domain && limit >= 1 && limit <= 1440) valid.push({ domain, limitMinutes: limit });
+    else skipped++;
+  }
+  return { valid, skipped };
+}
+
+exportBtn.addEventListener("click", async () => {
+  const { sites } = await send({ type: "GET_SNAPSHOT" });
+  const exported = {};
+  for (const [domain, { limitMinutes }] of Object.entries(sites)) {
+    exported[domain] = { limitMinutes };
+  }
+  const payload = { app: "lumina", version: 1, sites: exported };
+  const blob = new Blob([JSON.stringify(payload, null, 2)], { type: "application/json" });
+  const url = URL.createObjectURL(blob);
+  const a = document.createElement("a");
+  a.href = url;
+  a.download = "lumina-sites.json";
+  document.body.appendChild(a);
+  a.click();
+  a.remove();
+  setTimeout(() => URL.revokeObjectURL(url), 1000);
+  showStatus(`Đã xuất ${Object.keys(exported).length} trang.`);
+});
+
+importBtn.addEventListener("click", () => importFile.click());
+
+importFile.addEventListener("change", async () => {
+  const file = importFile.files[0];
+  importFile.value = ""; // allow picking the same file again
+  if (!file) return;
+  try {
+    const { valid, skipped } = parseImport(await file.text());
+    if (valid.length === 0) {
+      showStatus("Không có trang hợp lệ nào trong file.", true);
+      return;
+    }
+    for (const { domain, limitMinutes } of valid) {
+      await send({ type: "ADD_SITE", domain, limitMinutes });
+    }
+    await render();
+    showStatus(
+      `Đã nhập ${valid.length} trang` + (skipped ? `, bỏ qua ${skipped} mục không hợp lệ.` : ".")
+    );
+  } catch (err) {
+    showStatus(err instanceof SyntaxError ? "File không phải JSON hợp lệ." : err.message, true);
+  }
+});
+
 render();
